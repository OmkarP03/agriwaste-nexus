# ─────────────────────────────────────────────────────────────
#  AgriWaste Nexus — backend environment
#  Copy to .env and fill in. Never commit the real .env.
# ─────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────
# MongoDB. If SRV lookup fails on your network (querySrv ECONNREFUSED),
# use the non-SRV form Atlas offers under "Connect → Drivers → Node 2.2.12".
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/agriwaste

# The server refuses to start without this. Any long random string.
JWT_SECRET=change-me-to-something-long-and-random

PORT=5000

# ── Optional: email for password-reset OTPs ───────────────────
# Without these the OTP is printed to the server log instead of sent,
# which is fine for a demo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AgriWaste Nexus <no-reply@example.com>"

# ── Optional: SMS alerts to farmers and buyers ────────────────
# Leave SMS_PROVIDER empty and every alert is logged, not sent — the app
# works exactly the same, farmers just don't get a text. In-app
# notifications are unaffected either way.
#
# SMS_PROVIDER=msg91
#   MSG91_AUTHKEY=
#   MSG91_SENDER=AGRIWN      # 6-character sender ID approved by MSG91
#   MSG91_ROUTE=4
#
# SMS_PROVIDER=twilio
#   TWILIO_ACCOUNT_SID=
#   TWILIO_AUTH_TOKEN=
#   TWILIO_FROM=+1XXXXXXXXXX
SMS_PROVIDER=
